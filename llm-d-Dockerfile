FROM ghcr.io/llm-d/llm-d-cuda-dev@sha256:1e172053a3f218fb796ed755d9da26a386003188710b9bcd71a334b26be01f90

# Apply patch to fix UAR exhaustion on Mellanox NICs
# Configure NIXL num_threads to avoid UAR exhaustion issues with DeepEP kernels
# This modifies the nixl_connector.py file to make num_threads configurable
RUN python3 << 'EOF'
import re
import sys

file_path = '/opt/vllm-source/vllm/distributed/kv_transfer/kv_connector/v1/nixl_connector.py'

with open(file_path, 'r') as f:
    original_content = f.read()

content = original_content

# Add the configurable num_threads section after "non_ucx_backends" line
old_pattern = r'(        non_ucx_backends = \[b for b in self\.nixl_backends if b != "UCX"\])\n(        if nixl_agent_config is None:)'

new_code = r'''\1
        # Configure NIXL num_threads to avoid UAR exhaustion on Mellanox NICs.
        # Each UCX thread allocates UARs (doorbell pages) via DevX, and
        # excessive NIXL UAR usage can exhaust NIC UAR space. This can cause
        # components like NVSHMEM (used by DeepEP kernels) to fail during RDMA
        # initialization with "mlx5dv_devx_alloc_uar" errors.
        # Ref: https://network.nvidia.com/files/doc-2020/ethernet-adapters-programming-manual.pdf#page=63
        num_threads = vllm_config.kv_transfer_config.get_from_extra_config(
            "num_threads", 2
        )
\2'''

new_content = re.sub(old_pattern, new_code, content)
if new_content == content:
    print("ERROR: Failed to add num_threads configuration section")
    sys.exit(1)
else:
    print("✓ Successfully added num_threads configuration section")
    content = new_content

# Replace hardcoded num_threads=8 with num_threads=num_threads
old_text = 'non_ucx_backends) > 0 else nixl_agent_config(num_threads=8)'
new_text = 'non_ucx_backends) > 0 else nixl_agent_config(num_threads=num_threads)'

if old_text in content:
    content = content.replace(old_text, new_text)
    print("✓ Successfully replaced hardcoded num_threads=8 with configurable num_threads")
else:
    print("ERROR: Could not find hardcoded num_threads=8 to replace")
    sys.exit(1)

with open(file_path, 'w') as f:
    f.write(content)

print("✓ Patch applied successfully - all changes verified")
EOF

RUN cat /opt/vllm-source/vllm/distributed/kv_transfer/kv_connector/v1/nixl_connector.py